# Unity .gitignore
# https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity 생성 폴더
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity 로그 및 크래시 리포트
*.log
sysinfo.txt

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# TextMesh Pro 임포트 폴더 (Unity에서 언제든 재임포트 가능)
/[Aa]ssets/TextMesh Pro/
/[Aa]ssets/TextMesh Pro.meta

# IDE - Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/

# 솔루션 및 프로젝트 파일 (Unity가 자동 생성)
*.sln
*.slnx
*.csproj
*.unityproj
*.suo
*.user
*.userprefs

# Unity Language Server Cache
*.lscache

# 기타 빌드/디버그 파일
*.tmp
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 빌드 결과물
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics
crashlytics-build.properties

# OS 파일
.DS_Store
Thumbs.db
desktop.ini
